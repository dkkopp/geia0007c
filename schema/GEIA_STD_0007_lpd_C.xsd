	<xs:element name="lpd">
		<xs:annotation>
			<xs:documentation> This is the root element that defines the structure of the core LPD data entities and elements. It is a referenced element in the GEIA_STD_0007_C.xsd.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="base:metadata" minOccurs="0"/>
				<xs:element name="file" type="lpd:file_type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
